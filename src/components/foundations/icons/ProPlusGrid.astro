---
import Caption from '../../ui/Caption.astro';
import { PRO_PLUS } from '../../../data/foundations/icons';

/** Los doce packs Pro+, ilustrados con el mismo glifo (antes .ic-style-grid). */
---

<div class="grid">
  {PRO_PLUS.map((name) => (
    <div class="style">
      <div class="style__preview">
        <i class="fas fa-house" style="font-size:22px" aria-hidden="true"></i>
      </div>
      <span>{name}</span>
    </div>
  ))}
</div>
<Caption>
  Las muestras usan el glifo house a modo ilustrativo. En Figma cada pack Pro+ renderiza su tipografía de ícono
  instalada.
</Caption>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(88px, 1fr));
    gap: 10px;
    margin-top: 12px;
  }

  .style {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    padding: 12px 8px;
    border: 1px solid var(--color-line);
    border-radius: 10px;
    background: var(--color-surface);
  }

  .style__preview {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    border-radius: 8px;
    background: var(--color-brand-light);
    color: var(--color-brand-dark);
  }

  .style span {
    font-size: 11px;
    font-weight: 600;
    text-align: center;
    color: var(--color-muted);
  }
</style>
