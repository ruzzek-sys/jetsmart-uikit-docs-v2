---
import { CORE_PACKS, faClass } from '../../../data/foundations/icons';

/** Los tres packs Core de Font Awesome, cada uno con un glifo de muestra (antes .ic-pack-grid). */
---

<div class="grid">
  {CORE_PACKS.map((p) => (
    <article class="pack">
      <div class="pack__preview">
        <i class={faClass(p.style, p.glyph)} style="font-size:28px" aria-hidden="true"></i>
      </div>
      <h4>{p.name}</h4>
      <p>{p.description}</p>
    </article>
  ))}
</div>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(160px, 100%), 1fr));
    gap: 12px;
    margin-top: 12px;
  }

  .pack {
    padding: 16px;
    border: 1px solid var(--color-line);
    border-radius: 12px;
    background: var(--color-subtle);
    text-align: center;
  }

  .pack__preview {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 56px;
    margin-bottom: 10px;
    color: var(--color-brand);
  }

  .pack h4 {
    margin: 0 0 6px;
    font-size: 14px;
    font-weight: 600;
  }

  .pack p {
    margin: 0;
    font-size: 12px;
    line-height: 1.4;
    color: var(--color-muted);
  }
</style>
