---
/** Barra proporcional de una fila de tabla (antes .ty-bar): `value` sobre `max`. */
interface Props {
  value: number;
  max: number;
}

const { value, max } = Astro.props;
const pct = Math.round((value / max) * 100);
---

<span class="bar"><span class="bar__fill" style={`width:${pct}%`}></span></span>

<style>
  .bar {
    display: block;
    width: 160px;
    height: 8px;
    overflow: hidden;
    border-radius: 999px;
    background: var(--color-subtle);
  }

  .bar__fill {
    display: block;
    height: 100%;
    border-radius: 999px;
    background: var(--color-brand);
    opacity: 0.75;
  }

  @media (max-width: 639px) {
    .bar {
      width: 96px;
    }
  }
</style>
