---
/**
 * Barra superior. Bajo 1024 px lleva la hamburguesa y el botón de búsqueda, que abren el
 * sidebar como drawer. El drawer bloquea el scroll y deja inerte el resto de la página.
 */
---

<header
  id="topbar"
  class="sticky top-0 z-20 flex h-topbar items-center gap-3 border-b border-line bg-surface/95 px-4 backdrop-blur-md sm:px-5"
>
  <button
    type="button"
    class="topbar-btn"
    aria-label="Abrir navegación"
    aria-controls="sidebar"
    aria-expanded="false"
    data-drawer-toggle
  >
    <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
      <path d="M3 5h14M3 10h14M3 15h14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
    </svg>
  </button>
  <a href="/" class="text-sm font-bold">JetSmart UI Kit</a>
  <button type="button" class="topbar-btn ml-auto" aria-label="Buscar" data-drawer-search>
    <svg width="18" height="18" viewBox="0 0 16 16" fill="none" aria-hidden="true">
      <circle cx="7" cy="7" r="4.5" stroke="currentColor" stroke-width="1.5" />
      <path d="M10.5 10.5 14 14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
    </svg>
  </button>
</header>

<script>
  const body = document.body;
  const toggle = document.querySelector<HTMLButtonElement>('[data-drawer-toggle]')!;
  const column = document.querySelector<HTMLElement>('#main-column');
  const desktop = window.matchMedia('(min-width: 1024px)');

  function setOpen(open: boolean) {
    if (desktop.matches) open = false;
    body.classList.toggle('drawer-open', open);
    toggle.setAttribute('aria-expanded', String(open));
    // «inert» saca la página del foco y del lector mientras el drawer está abierto.
    column?.toggleAttribute('inert', open);
  }

  toggle.addEventListener('click', () => {
    const open = !body.classList.contains('drawer-open');
    setOpen(open);
    if (open) document.querySelector<HTMLElement>('#sidebar [aria-current="page"], #nav-search')?.focus();
  });
  document.querySelector('[data-drawer-search]')!.addEventListener('click', () => {
    setOpen(true);
    window.dispatchEvent(new CustomEvent('search:focus'));
  });
  document.querySelector('[data-drawer-close]')!.addEventListener('click', () => setOpen(false));
  window.addEventListener('drawer:open', () => setOpen(true));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && body.classList.contains('drawer-open')) {
      setOpen(false);
      toggle.focus();
    }
  });
  desktop.addEventListener('change', () => setOpen(false));
</script>

<style>
  .topbar-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 40px;
    border: 1px solid var(--color-line);
    border-radius: 8px;
    background: var(--color-surface);
    color: var(--color-ink);
    cursor: pointer;
  }

  .topbar-btn:hover {
    background: var(--color-subtle);
  }

  /* Va acá y no como utilidad lg:hidden: el CSS scoped le gana a las capas de Tailwind. */
  @media (min-width: 1024px) {
    .topbar-btn {
      display: none;
    }
  }
</style>
