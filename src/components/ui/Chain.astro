---
/**
 * Cadena de herencia Tier 1 → Tier 2 → … (antes .ty-chain). En desktop va en fila con
 * flechas; bajo 640 px se apila y las flechas apuntan hacia abajo.
 */
interface Props {
  steps: { tier: string; code: string; note: string; focus?: boolean }[];
}

const { steps } = Astro.props;
---

<div class="chain">
  {steps.map((s, i) => (
    <>
      {i > 0 && <div class="chain__arrow" aria-hidden="true">→</div>}
      <div class:list={['chain__step', { 'chain__step--focus': s.focus }]}>
        <span class="chain__tier">{s.tier}</span>
        <code set:html={s.code} />
        <span class="chain__note" set:html={s.note} />
      </div>
    </>
  ))}
</div>

<style>
  .chain {
    display: flex;
    align-items: stretch;
    gap: 8px;
    margin-top: 24px;
    padding-bottom: 4px;
    overflow-x: auto;
  }

  .chain__step {
    flex: 1 1 0;
    min-width: 190px;
    padding: 14px;
    border: 1px solid var(--color-line);
    border-radius: 10px;
    background: var(--color-surface);
  }

  .chain__step--focus {
    border-color: var(--color-brand);
    background: var(--color-brand-light);
  }

  .chain__tier {
    display: block;
    margin-bottom: 8px;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .chain__step code {
    display: block;
    font-family: var(--font-mono);
    font-size: 12px;
    line-height: 1.5;
    word-break: break-all;
    color: var(--color-ink);
  }

  .chain__note {
    display: block;
    margin-top: 8px;
    font-size: 12px;
    color: var(--color-muted);
  }

  .chain__arrow {
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-muted);
  }

  @media (max-width: 639px) {
    .chain {
      flex-direction: column;
      overflow: visible;
    }

    .chain__step {
      min-width: 0;
    }

    .chain__arrow {
      transform: rotate(90deg);
    }
  }
</style>
