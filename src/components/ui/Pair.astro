---
/**
 * Par «Hazlo / Evítalo» de Buenas y malas prácticas (antes .ty-pair).
 * El slot por defecto lleva la explicación; los slots `do` y `dont` llevan un <PairCol>.
 */
interface Props {
  eyebrow: string;
  title: string;
}

const { eyebrow, title } = Astro.props;
---

<article class="pair">
  <p class="pair__eyebrow">{eyebrow}</p>
  <h3 set:html={title} />
  <slot />
  <div class="pair__grid">
    <slot name="do" />
    <slot name="dont" />
  </div>
</article>

<style>
  .pair {
    margin-top: 28px;
    padding: 20px;
    border: 1px solid var(--color-line);
    border-radius: 14px;
  }

  .pair__eyebrow {
    margin: 0 0 6px;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-brand);
  }

  .pair h3 {
    margin: 0 0 8px;
    font-size: 17px;
    font-weight: 600;
  }

  .pair > :global(p:not([class])) {
    margin: 8px 0 0;
    font-size: 14px;
    line-height: 1.65;
  }

  .pair__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    margin-top: 20px;
  }

  @media (max-width: 860px) {
    .pair {
      padding: 16px;
    }

    .pair__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
