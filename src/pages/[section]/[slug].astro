---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { mdxComponents } from '../../components/doc/mdx-components';
import { DOC_SECTIONS, type DocSectionId } from '../../data/nav';
import { assertFigmaNodes } from '../../lib/docs';

/** Páginas de Components, Product Components y Flows: una por cada .mdx de su colección. */
export async function getStaticPaths() {
  const sections = Object.keys(DOC_SECTIONS) as DocSectionId[];
  const paths = await Promise.all(
    sections.map(async (section) =>
      (await getCollection(section)).map((entry) => ({ params: { section, slug: entry.id }, props: { entry } })),
    ),
  );
  return paths.flat();
}

const { entry } = Astro.props;
// PropsTable, DocTable y FigmaEmbed leen de acá los datos del frontmatter.
Astro.locals.doc = entry;
const { Content, headings } = await render(entry);
assertFigmaNodes(entry);
---

<BaseLayout title={entry.data.title} description={entry.data.description} headings={headings}>
  <Content components={mdxComponents} />
</BaseLayout>
